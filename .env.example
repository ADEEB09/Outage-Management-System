# PostgreSQL connection string used by server/index.js
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/oms
# Local PostgreSQL usually has SSL disabled. Set true only for a hosted DB that requires it.
DB_SSL=false
# Optional PEM files for a TLS-enabled PostgreSQL server. Use absolute Windows paths.
# DB_SSL_CA=C:\\certs\\postgres-ca.pem
# DB_SSL_CERT=C:\\certs\\client-cert.pem
# DB_SSL_KEY=C:\\certs\\client-key.pem
# DB_SSL_REJECT_UNAUTHORIZED=true
PORT=14000
# Set this to the web app origin in production instead of *
CORS_ORIGIN=http://localhost:15173
# Reliability indices (IEEE 1366): customers served, the SAIFI/SAIDI/MAIFI denominator.
# Also used to allocate predicted customers to a tripped feeder by kVA share.
CUSTOMERS_SERVED=18500
# A SCADA trip whose device recloses within this many minutes is a momentary
# interruption: auto-closed, counted in MAIFI, excluded from SAIFI/SAIDI.
MOMENTARY_MAX_MIN=5
# FAT/test only: enables POST /api/scada/simulate (system_admin) to trip/reclose
# a device without a real RTU. Leave false in production.
ENABLE_SCADA_SIMULATION=false
