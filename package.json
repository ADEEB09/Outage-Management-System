{
  "name": "oms-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outage Management System control room and crew app",
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "photo-server": "node server/index.js",
    "native": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web:native": "expo start --web",
    "seed": "npm --workspace backend run seed",
    "dev:backend": "npm --workspace backend start",
    "dev:web": "npm --workspace frontend run dev",
    "dev:mobile": "npm --workspace mobile run dev",
    "test": "npm --workspace backend run test",
    "start": "concurrently -n backend,web,mobile -c cyan,green,magenta \"npm:dev:backend\" \"npm:dev:web\" \"npm:dev:mobile\"",
    "build:leaflet": "node scripts/build-leaflet-bundle.mjs",
    "build:icons": "node scripts/build-app-icons.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.4",
    "expo": "~57.0.24",
    "expo-auth-session": "^57.0.11",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.19",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-task-manager": "~57.0.19",
    "expo-web-browser": "~57.0.3",
    "pg": "^8.16.3",
    "pg-promise": "^12.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "leaflet": "1.9.4",
    "shadcn": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
